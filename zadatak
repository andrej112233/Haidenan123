import java.util.Scanner;

public class Main {

    static int[] a;
    static int n;

    static void preorder(int i) {
        if (i >= n) return;

        System.out.print(a[i] + " ");
        preorder(2 * i + 1);
        preorder(2 * i + 2);
    }

    static void inorder(int i) {
        if (i >= n) return;

        inorder(2 * i + 1);
        System.out.print(a[i] + " ");
        inorder(2 * i + 2);
    }

    static void postorder(int i) {
        if (i >= n) return;

        postorder(2 * i + 1);
        postorder(2 * i + 2);
        System.out.print(a[i] + " ");
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("Unesi brojeve:");
        String red = sc.nextLine();

        String[] dijelovi = red.trim().split("\s+");

        n = dijelovi.length;
        a = new int[n];

        for (int i = 0; i < n; i++) {
            a[i] = Integer.parseInt(dijelovi[i]);
        }

        System.out.println("Izaberi obilazak:");
        System.out.println("1 - Preorder");
        System.out.println("2 - Inorder");
        System.out.println("3 - Postorder");

        int izbor = sc.nextInt();

        System.out.println("Rezultat:");

        if (izbor == 1)
            preorder(0);
        else if (izbor == 2)
            inorder(0);
        else if (izbor == 3)
            postorder(0);
        else
            System.out.println("Pogresan izbor!");

        sc.close();
    }
}
