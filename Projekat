import java.util.Scanner;

class Cvor {
    int broj;
    Cvor lijevo, desno;

    Cvor(int x) {
        broj = x;
    }
}

public class Main {

    static Cvor ubaci(Cvor korijen, int x) {
        if (korijen == null)
            return new Cvor(x);

        if (x < korijen.broj)
            korijen.lijevo = ubaci(korijen.lijevo, x);
        else
            korijen.desno = ubaci(korijen.desno, x);

        return korijen;
    }

    static void ispisi(Cvor korijen) {
        if (korijen != null) {
            ispisi(korijen.lijevo);
            System.out.print(korijen.broj + " ");
            ispisi(korijen.desno);
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        Cvor korijen = null;

        System.out.println("Koliko brojeva zelite unijeti?");
        int n = sc.nextInt();

        System.out.println("Unesite brojeve:");

        for (int i = 0; i < n; i++) {
            int x = sc.nextInt();
            korijen = ubaci(korijen, x);
        }

        System.out.println("Sortirani brojevi:");

        ispisi(korijen);
    }
}
